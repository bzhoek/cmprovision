#!/bin/sh

set -e

DATA=/var/lib/cmprovision
UNITS="cmprovision.service cmprovision-dnsmasq.service cmprovision-rpiboot.service"

case "$1" in
  configure)

    install -d -o www-data -g www-data -m 755 "$DATA/database" "$DATA/public" "$DATA/public/uploads" "$DATA/storage" "$DATA/storage/app" "$DATA/storage/app/firmware"

    # Saved by preinst when upgrading from the PHP version.
    if [ -d "$DATA/storage/app/firmware.preserved" ]; then
        cp -anl "$DATA/storage/app/firmware.preserved/." "$DATA/storage/app/firmware/"
        rm -rf "$DATA/storage/app/firmware.preserved"
        chown -R www-data:www-data "$DATA/storage/app/firmware"
    fi
    # Static IP assignments are written into it by the web interface.
    chown www-data:www-data "$DATA/etc/dnsmasq.conf"

    # Upgrading from the PHP version: cmprovision now serves port 80 itself.
    if [ -L /etc/nginx/sites-enabled/cmprovision ]; then
        rm -f /etc/nginx/sites-enabled/cmprovision
        if [ -z "$(ls -A /etc/nginx/sites-enabled 2>/dev/null)" ]; then
            echo "Stopping and disabling nginx, which served only the old cmprovision web interface"
            systemctl stop nginx.service || true
            systemctl disable nginx.service || true
        else
            systemctl reload nginx.service || true
        fi
    fi
    # Images are hashed in-process now.
    systemctl stop cmprovision-queue.service 2>/dev/null || true
    deb-systemd-helper purge cmprovision-queue.service >/dev/null 2>&1 || true
    # Generated by Laravel at runtime, so dpkg does not remove them with the old package's files.
    rm -rf "$DATA/bootstrap" "$DATA/storage/framework" "$DATA/storage/logs" "$DATA/vendor" "$DATA/.env"

    FRESH=
    if [ ! -e "$DATA/database/database.sqlite" ]; then
        echo "Initializing database"
        FRESH=1
    fi
    runuser -u www-data -- /usr/bin/cmprovision migrate
    chmod 600 "$DATA/database/database.sqlite"

    # The Ethernet-over-USB method used for provisioning CM3 requires server has predictable IPv6 link-local addresses
    if [ -e /etc/dhcpcd.conf ] && grep -q "slaac private" /etc/dhcpcd.conf; then
        echo "Changing dhcpcd settings to let server have predictable IPv6 link-local address"
        sed -i "s#slaac private#slaac hwaddr#" /etc/dhcpcd.conf
        systemctl restart dhcpcd.service || true
    fi

    systemctl daemon-reload || true
    for unit in $UNITS; do
        deb-systemd-helper unmask "$unit" >/dev/null || true
        deb-systemd-helper enable "$unit" >/dev/null || true
        deb-systemd-invoke restart "$unit" || true
    done

    if [ -n "$FRESH" ]; then
        echo "Create a web interface user with: sudo -u www-data cmprovision create-user"
    fi
  ;;
esac

exit 0
