#!/bin/sh

set -e

UNITS="cmprovision.service cmprovision-dnsmasq.service cmprovision-rpiboot.service"

case "$1" in
  remove)
    systemctl daemon-reload || true
    for unit in $UNITS; do
        deb-systemd-helper mask "$unit" >/dev/null || true
    done
  ;;
  # The PHP package deleted the database on remove; keep data until an explicit purge.
  purge)
    for unit in $UNITS; do
        deb-systemd-helper purge "$unit" >/dev/null || true
        deb-systemd-helper unmask "$unit" >/dev/null || true
    done
    rm -rf /var/lib/cmprovision/database /var/lib/cmprovision/storage /var/lib/cmprovision/public/uploads /var/lib/cmprovision/.env
  ;;
esac

exit 0
